# docs/adr/0042 / docs/self-hosting.md — copy to .env, fill in every value
# marked CHANGE ME. Unlike the dev .env.example, there is no working
# default for most of these: a real domain, a real SMTP provider, and
# real secrets are not optional in production.

# --- Domain & TLS ---
DOMAIN=example.com
ACME_EMAIL=you@example.com

# --- Public origins: only if you DON'T use the bundled Caddy ---
# Leave these commented out and they are derived from DOMAIN, which is right
# for the layout this repo ships (Caddy, three subdomains, HTTPS on 443).
#
# Set all three together if you front the stack yourself — TLS terminated
# upstream, one domain with path-based routing, a port other than 443. A
# browser origin is scheme+host+port, and three separate things pin the
# editor's: the API's CORS allow-list (an exact match, because credentialed
# cookies cannot use a wildcard, docs/adr/0010), public-site's
# frame-ancestors for the canvas iframe, and the URLs Vite bakes into the
# editor bundle. Get one wrong and the editor loads while every API call
# fails CORS, with nothing on screen saying why.
#
# Changing API_PUBLIC_URL or PUBLIC_SITE_URL rebuilds the editor image
# (they are build-time for Vite); EDITOR_APP_URL is read at runtime.
# EDITOR_APP_URL=https://admin.example.com
# API_PUBLIC_URL=https://api.example.com/api
# PUBLIC_SITE_URL=https://example.com

# --- Postgres ---
POSTGRES_USER=kometio
# Both at least 16 characters (openssl rand -hex 24); the API refuses to
# start in production on a shorter one or on an example value.
POSTGRES_PASSWORD=
POSTGRES_DB=kometio
POSTGRES_APP_PASSWORD=

# --- Tenant, site and the first admin account are NOT set here ---
# They are created by the first-run wizard, the first time you open
# https://admin.<domain> (docs/self-hosting.md). That is deliberate: an
# admin password in a file on the server, in plaintext, that then stays
# there, is not something to ask for when a form can do the same job once.
#
# DEFAULT_TENANT_ID / DEFAULT_SITE_ID / DEFAULT_USER_EMAIL /
# DEFAULT_USER_PASSWORD are still honoured, and are what the seed scripts
# need — see "If you would rather not use the wizard" in the self-hosting
# guide. Leave them unset unless you are automating a deployment.

# At least 32 characters: openssl rand -hex 32. It signs preview links;
# a guessable one lets anyone read drafts.
PREVIEW_TOKEN_SECRET=

# --- Optional: comma-separated allow-list restricting which of the
# bundled themes this deployment will serve, e.g. KOMETIO_THEME=classic —
# what an agency sets so its client can only ever pick the agency's own
# theme. Unset (the default): every bundled theme is selectable. This
# does NOT pick which theme a site currently uses — that's chosen live
# from editor-app's Style dialog (Site.themeName). Read at runtime by
# public-site, so changing it needs a restart, not a rebuild
# (docs/adr/0021/0042). ---
# KOMETIO_THEME=

# --- SMTP (a real provider — Mailpit is dev-only). OPTIONAL: left empty, the
# API still starts and writes each email (an invitation, a password reset)
# to its log, link included — `docker compose logs api` — and the editor
# tells the administrator so. With SMTP_HOST set, the port and the sender
# are required (docs/adr/0103). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_USER=
SMTP_PASSWORD=

# --- Cloudflare Turnstile: your site's own keys, from the Cloudflare
# dashboard (Turnstile → Add site). Cloudflare's published test keys pass
# every captcha, so the API refuses them in production. ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Postgres backup sidecar ---
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# --- Strongly recommended: rate-limit the visitor, not your own server ---
# The public site renders pages on the server, so every visitor's page view
# reaches the API from the SAME address: without this the whole site shares
# one 120-requests-per-minute bucket, and a busy minute answers 500 to
# everybody at once. Set it and the API counts the actual visitor instead.
# The same value on both services — they read this same file.
#   openssl rand -hex 32   (at least 32 characters)
PUBLIC_API_SERVICE_TOKEN=

# --- Optional: S3-compatible media storage instead of local disk ---
# MEDIA_STORAGE_PROVIDER=s3
# S3_MEDIA_BUCKET=kometio-media
# S3_MEDIA_REGION=us-east-1
# S3_MEDIA_ENDPOINT=
# S3_MEDIA_FORCE_PATH_STYLE=false
# S3_MEDIA_ACCESS_KEY_ID=
# S3_MEDIA_SECRET_ACCESS_KEY=
# S3_MEDIA_PUBLIC_BASE_URL=

# --- Optional: newsletter provider ---
# NEWSLETTER_PROVIDER=mailchimp
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=
# NEWSLETTER_PROVIDER=brevo
# BREVO_API_KEY=
# BREVO_LIST_ID=

# Page generation with AI (docs/self-hosting.md, "Generating pages with AI").
# Where the key that seals each site's AI API key is generated — or set
# KOMETIO_SECRETS_KEY (openssl rand -base64 32) to provide it yourself.
# Neither set: page generation is off.
# Set by docker-compose.prod.yml to /data/secrets (the `secrets` volume).
# KOMETIO_SECRETS_DIR=
# KOMETIO_SECRETS_KEY=
# A model server inside the network — on this machine (Ollama, LM Studio)
# or a private address — is refused unless this is true. Leave it unset if
# anyone who is not you can be an admin of a site here.
# KOMETIO_AI_ALLOW_PRIVATE_HOSTS=true
