---
import {
  STAR_ICON_PATH,
  type TestimonialProps,
} from '@kometio/shared-types';
import { Translator } from '@kometio/theme-runtime';
import OptimizedImage from '../OptimizedImage.astro';
import { fixedSizes } from '../../lib/image-sizes';

type Props = TestimonialProps & { locale?: string; instanceClass?: string | null };

const { quote, author, role, avatar, rating, locale, instanceClass } = Astro.props;
// Rating.astro's reason: the stars were announced in Italian everywhere.
const i18n = new Translator(locale ?? '');

const STAR_POSITIONS = [1, 2, 3, 4, 5];
---

<div class:list={['kometio-testimonial', instanceClass]}>
  <div
    class="kometio-testimonial__stars"
    role="img"
    aria-label={i18n.t('rating.label', { value: rating })}
  >
    {
      // Filled stars are the rating colour (global.css), as Rating's.
      STAR_POSITIONS.map((position) => (
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
          <path
            d={STAR_ICON_PATH}
            fill={position <= rating ? 'var(--kometio-rating)' : 'var(--border)'}
          />
        </svg>
      ))
    }
  </div>
  <blockquote class="kometio-testimonial__quote kometio-rich-text" data-kometio-field="quote" set:html={quote} />
  <div class="kometio-testimonial__footer">
    {avatar && (
      <OptimizedImage
        media={avatar}
        alt=""
        class="kometio-testimonial__avatar"
        sizes={fixedSizes(40)}
      />
    )}
    <div>
      <div class="kometio-testimonial__author" data-kometio-field="author">{author}</div>
      {role && <div class="kometio-testimonial__role" data-kometio-field="role">{role}</div>}
    </div>
  </div>
</div>

<style>
  .kometio-testimonial {
    /* Neither of these decides the card's width any more (ADR-0052): the
       track is a grid, so its `grid-auto-columns` does — at the same
       `min(320px, 85vw)` this declared, which is why the card is the same
       size as before. Kept because a card can also sit outside a
       collection track, where a flex parent would still ask. */
    flex: 0 0 min(320px, 85vw);
    scroll-snap-align: start;
    border: 1px solid var(--border);
    border-radius: var(--kometio-override-radius, 12px);
    padding: var(--kometio-override-padding-y, 1.5rem)
      var(--kometio-override-padding-x, 1.5rem);
    background: var(--kometio-override-bg, transparent);
  }
  .kometio-testimonial__stars {
    display: flex;
    gap: 2px;
  }
  .kometio-testimonial__quote {
    margin: 0.75rem 0;
    font-size: 0.9375rem;
    color: var(--kometio-override-text, var(--foreground));
  }
  .kometio-testimonial__footer {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  /* :global() because OptimizedImage (a child component) renders the
  actual <img> — see Image.astro's own style block for the full reasoning. */
  :global(.kometio-testimonial__avatar) {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .kometio-testimonial__author {
    font-weight: 600;
    font-size: 0.875rem;
  }
  .kometio-testimonial__role {
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }
</style>
