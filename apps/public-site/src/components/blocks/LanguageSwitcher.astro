---
import type { LanguageSwitcherProps } from '@kometio/shared-types';
import type { PublishedPageTranslation, PublishedSite } from '@kometio/api-contracts';
import { languageLinks, Translator } from '@kometio/theme-runtime';

interface Props extends LanguageSwitcherProps {
  locale: string;
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;
  translations: PublishedPageTranslation[];
  site: PublishedSite;
}

const { position, visibility, locale, translations, site,
  instanceClass,
} = Astro.props;

// One entry per enabled locale that has somewhere to send the visitor (the
// rule is languageLinks's, shared with every theme's restyle of this block).
const links = languageLinks(site, translations);
const i18n = new Translator(locale);
---

{
  links.length > 1 && (
    <nav
      class:list={[
        'kometio-language-switcher',
        { 'kometio-language-switcher--right': position === 'right' },
        { 'kometio-visibility-desktop-only': visibility === 'desktop-only' },
        { 'kometio-visibility-mobile-only': visibility === 'mobile-only' },
        instanceClass,
      ]}
      aria-label={i18n.t('languageSwitcher.label')}
    >
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={link.locale === locale ? 'true' : undefined}
        >
          {link.locale.toUpperCase()}
        </a>
      ))}
    </nav>
  )
}

<style>
  /* Fallbacks are what this block already rendered. */
  .kometio-language-switcher {
    display: flex;
    gap: var(--kometio-override-gap, 0.5rem);
    background: var(--kometio-override-bg, transparent);
    color: var(--kometio-override-text, inherit);
    border-radius: var(--kometio-override-radius, 0);
    padding: var(--kometio-override-padding-y, 0)
      var(--kometio-override-padding-x, 0);
  }
  .kometio-language-switcher--right {
    margin-left: auto;
  }
  .kometio-language-switcher a[aria-current='true'] {
    font-weight: 600;
    text-decoration: underline;
  }
</style>
