---
import sanitizeHtml from 'sanitize-html';
import type { EmbedHtmlProps } from '@kometio/shared-types';
import type { PublishedSite } from '@kometio/api-contracts';
import type { Translator } from '@kometio/theme-runtime';
import { isDemoDeployment } from '../../lib/demo-mode';

type Props = EmbedHtmlProps & {
  i18n: Translator;
  site: PublishedSite;
  editable?: boolean;
  instanceClass?: string | null;
};

const {
  html,
  consentCategory = 'experience',
  i18n,
  site,
  editable,
  instanceClass,
} = Astro.props;
// In a demo (docs/adr/0118) the account everybody signs in with can paste
// anything here, and a frame that may open forms and popups, at the demo's
// own address, is a phishing page with a good name. It is not run there.
const inDemo = isDemoDeployment();
// Its scripts and frames are a third party's, and nothing of it is asked for
// until the visitor has answered the banner for its category (docs/adr/0131):
// it sits in an inert <template>, which the consent bootstrap opens once the
// category is granted — the same mechanism the site's trackers go through.
// Only where there is a banner to answer (a site with none has no consent to
// wait for, and would never show it), and not in the editor's canvas, which
// has no visitor and no consent record: there the editor sees what they wrote.
const waitsForConsent =
  !inDemo &&
  consentCategory !== 'necessary' &&
  site.cookieBannerSettings.enabled &&
  editable !== true;

// Permissive policy (confirmed with the user, 2026-08-19): script/iframe
// stay allowed — that's what a free-embed block is for (YouTube, Calendly,
// chat widgets, analytics snippets) — but every `on*` inline event-handler
// attribute is stripped as defense in depth even inside the sandbox below.
const stripEventHandlers: sanitizeHtml.Transformer = (tagName, attribs) => {
  const safeAttribs: sanitizeHtml.Attributes = {};
  for (const [name, value] of Object.entries(attribs)) {
    if (!name.toLowerCase().startsWith('on')) {
      safeAttribs[name] = value;
    }
  }
  return { tagName, attribs: safeAttribs };
};

const safeHtml = sanitizeHtml(html, {
  allowedTags: false,
  allowedAttributes: false,
  allowVulnerableTags: true,
  transformTags: { '*': stripEventHandlers },
});

// Security review 2026-08-24 follow-up: the page's own CSP (see
// content-security-policy.ts) now locks script-src down to 'self' — a
// pasted third-party <script> would simply be blocked by the browser if it
// ran in the main document. Rendered inside a sandboxed <iframe> instead:
// isolated from the real page's cookies/localStorage/DOM (no
// `allow-same-origin` — the one sandbox token that would undo that
// isolation for a `srcdoc` frame, since it grants the *embedding* page's
// origin rather than a truly opaque one). A `srcdoc` document inherits its
// parent's CSP unless it declares its own via a <meta> tag (there is no
// real HTTP response to carry a header) — the permissive policy below is
// exactly what the top-level page's CSP no longer allows directly,
// deliberately scoped to only this iframe's own isolated document.
const srcDoc = `<!doctype html>
<html>
<head>
<meta charset="utf-8" />
<meta http-equiv="Content-Security-Policy" content="default-src * data: blob: 'unsafe-inline' 'unsafe-eval'; script-src * data: blob: 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline';" />
<style>html,body{margin:0;padding:0;}</style>
</head>
<body>
${safeHtml}
<script>
  (function () {
    function reportHeight() {
      parent.postMessage(
        { kometioEmbedHtmlHeight: document.documentElement.scrollHeight },
        '*',
      );
    }
    new ResizeObserver(reportHeight).observe(document.body);
    reportHeight();
  })();
</script>
</body>
</html>`;
---

<div class:list={['kometio-embed-html', instanceClass]}>
  {/*
    allow-popups-to-escape-sandbox stays, on purpose (audit B8, 2026-09-29):
    without it a popup the embed opens — "Watch on YouTube", a booking
    page — inherits this sandbox with no origin of its own and arrives
    broken. A popup that escapes is an ordinary new tab to wherever the
    embed points, which an editor can already link to; it gets nothing of
    this page, since the frame never had allow-same-origin. allow-forms
    is what a pasted newsletter form needs to submit.
  */}
  {
    inDemo ? (
      <p class="kometio-embed-html__demo">{i18n.t('embedHtml.demo')}</p>
    ) : waitsForConsent ? (
      <>
        <p class="kometio-embed-html__consent">
          {i18n.t('embedHtml.consent.message')}{' '}
          <button
            type="button"
            class="kometio-embed-html__preferences"
            data-kometio-cookie-preferences
          >
            {i18n.t('embedHtml.consent.button')}
          </button>
        </p>
        <template data-kometio-consent={consentCategory}>
          <iframe
            class="kometio-embed-html__frame"
            sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-forms"
            loading="lazy"
            title="Contenuto incorporato"
            srcdoc={srcDoc}
          />
        </template>
      </>
    ) : (
      <iframe
        class="kometio-embed-html__frame"
        sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-forms"
        loading="lazy"
        title="Contenuto incorporato"
        srcdoc={srcDoc}
      />
    )
  }
</div>

<script>
  // Logic lives in a plain importable module, not inline here — a
  // self-contained inline script (no `import`, only one consumer) gets
  // inlined by Astro directly into the SSR HTML instead of hoisted to an
  // external file, and the strict CSP then blocks it with no visible
  // error (see cookie-consent-panel-script.ts's own comment, PR #125,
  // for the confirmed root cause). Also lets this re-run after a live
  // canvas insert/patch — see block-behaviors/run-block-behaviors-in-subtree.ts.
  import { cookiePreferencesBehaviors } from '../../lib/block-behaviors/cookie-preferences';
  import {
    embedHtmlBehaviors,
    settleEmbeds,
  } from '../../lib/block-behaviors/embed-html';
  import { runBlockBehaviors } from '../../lib/block-behaviors/run-block-behaviors';
  runBlockBehaviors(document, embedHtmlBehaviors);
  runBlockBehaviors(document, cookiePreferencesBehaviors);
  // An embed that waited for the banner is in the page only after this has
  // run (the consent bootstrap opens it at DOMContentLoaded, or when the
  // visitor answers), so it is looked for again when that happens.
  document.addEventListener('kometio-consent-activated', () => {
    runBlockBehaviors(document, embedHtmlBehaviors);
    settleEmbeds(document);
  });
</script>

<style>
  .kometio-embed-html {
    @kometio-bridge background border-radius padding;
  }
  .kometio-embed-html__consent {
    margin: 0;
    padding: 1rem;
    border: 1px dashed currentColor;
    text-align: center;
    opacity: 0.8;
  }
  .kometio-embed-html__preferences {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .kometio-embed-html__demo {
    margin: 0;
    padding: 1rem;
    border: 1px dashed currentColor;
    text-align: center;
    opacity: 0.7;
  }
  .kometio-embed-html__frame {
    display: block;
    width: 100%;
    max-width: 100%;
    border: none;
    /* Overwritten in px by the resize listener above once the iframe's
       content reports its real height — this is only the pre-load guess. */
    height: 150px;
  }
</style>
