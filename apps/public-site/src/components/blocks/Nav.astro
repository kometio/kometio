---
import type { NavProps } from '@kometio/shared-types';
import type { Translator } from '@kometio/theme-runtime';

type Props = NavProps & {
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;
  /** The page's header or footer, when the navigation is in one: it is what names it. */
  region?: 'header' | 'footer';
  i18n: Translator;
};

const { visibility, instanceClass, region, i18n } = Astro.props;
---

<!--
  A name for the landmark, in the header and in the footer: with one in each
  and no names, a reader who lists the page's landmarks gets "navigation,
  navigation" (axe: landmark-unique). A navigation in the page's content has
  none, which is fine while it is the only one without.
-->
<nav
  aria-label={region ? i18n.t(`nav.${region}`) : undefined}
  class:list={[
    'kometio-nav',
    { 'kometio-visibility-desktop-only': visibility === 'desktop-only' },
    { 'kometio-visibility-mobile-only': visibility === 'mobile-only' },
    instanceClass,
  ]}
>
  <slot />
</nav>

<style>
  /* Every fallback is what this block already rendered. `gap` matters
     most here: the space between nav links was a fixed 1rem, so a dense
     header and an airy one were not expressible. */
  .kometio-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    @kometio-bridge gap background color border-radius padding;
  }
</style>
