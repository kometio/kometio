---
import type { WhatsAppButtonProps } from '@kometio/shared-types';
import { Translator } from '@kometio/theme-runtime';

type Props = WhatsAppButtonProps & {
  locale: string;
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;
};

const { phoneNumber, message, visibility, locale, instanceClass } =
  Astro.props;
const i18n = new Translator(locale);

// `message` is optional pre-filled text — omit `?text=` entirely rather
// than sending an empty one when the editor left it blank.
const href = message
  ? `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`
  : `https://wa.me/${phoneNumber}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    // The type class the site-wide style of WhatsAppButton targets —
    // `whats-app`, as the type name splits — beside the one its own
    // stylesheet has always used.
    'kometio-whats-app-button',
    'kometio-whatsapp-button',
    { 'kometio-visibility-desktop-only': visibility === 'desktop-only' },
    { 'kometio-visibility-mobile-only': visibility === 'mobile-only' },
    instanceClass,
  ]}
  aria-label={i18n.t('whatsAppButton.label')}
>
  <svg viewBox="0 0 24 24" width="28" height="28" fill="#fff" aria-hidden="true">
    <path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.35 5.07L2 22l5.06-1.32A9.94 9.94 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm5.2 14.27c-.22.62-1.28 1.19-1.77 1.24-.45.05-.9.24-3.02-.63-2.55-1.05-4.2-3.62-4.33-3.79-.13-.17-1.04-1.38-1.04-2.63s.66-1.87.9-2.13c.22-.24.48-.3.65-.3.16 0 .32 0 .46.01.15.01.35-.06.55.42.22.53.73 1.83.8 1.97.07.14.12.3.02.48-.09.18-.14.29-.28.45-.14.16-.29.36-.42.48-.14.13-.28.28-.12.55.16.27.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.21 1.37.27.14.43.12.59-.07.16-.19.68-.79.86-1.06.18-.27.36-.22.6-.13.25.09 1.57.74 1.84.87.27.14.45.2.51.32.07.11.07.65-.15 1.27z" />
  </svg>
</a>

<style>
  /* bottom-RIGHT, not bottom-left: when a BackToTop button is also placed
     (the common case), it sits bottom-left — see BackToTop.astro's own
     comment for why the two independent blocks split corners instead of
     coordinating some other way. Background stays WhatsApp's own literal
     green (#25d366) regardless of theme — a brand-recognition color, not
     Kometio's; same reasoning as Rating/Testimonial's filled-star amber and
     Form's status colors. */
  .kometio-whatsapp-button {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 30;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--kometio-override-radius, 50%);
    /* WhatsApp's own green stays the default — a brand-recognition
       colour, as the comment above says — but it is a default now rather
       than a constant: a site whose palette clashes with it can say so. */
    background: var(--kometio-override-bg, #25d366);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--kometio-override-shadow, 0 4px 12px rgb(0 0 0 / 20%));
  }
</style>
