---
import type { PricingPlanProps } from '@kometio/shared-types';
import { resolveLinkHref } from '@kometio/theme-runtime';

type Props = PricingPlanProps & { instanceClass?: string | null };

const {
  name,
  price,
  period,
  features,
  highlighted,
  buttonLabel,
  linkType,
  page,
  url,
  instanceClass } = Astro.props;
// One answer for both questions: where this points, and whether there
// is a button at all. They used to be two expressions that could
// disagree — `hasLink` was true for a picked page with no address in
// this locale, and `href` then fell back to the url field (ADR-0063).
const href = resolveLinkHref({ linkType, page, url });
const hasLink = href !== null;
---

<div
  class:list={[instanceClass, 'kometio-pricing-plan', { 'kometio-pricing-plan--highlighted': highlighted }]}
>
  <div class="kometio-pricing-plan__name" data-kometio-field="name">{name}</div>
  <div class="kometio-pricing-plan__price">
    <span data-kometio-field="price">{price}</span><span class="kometio-pricing-plan__period" data-kometio-field="period">{period}</span>
  </div>
  {
    features.length > 0 && (
      <ul class="kometio-pricing-plan__features">
        {features.map((feature) => (
          <li>{feature}</li>
        ))}
      </ul>
    )
  }
  {
    hasLink && (
      <a class="kometio-pricing-plan__button" href={href} data-kometio-field="buttonLabel">
        {buttonLabel}
      </a>
    )
  }
</div>

<style>
  .kometio-pricing-plan {
    border: 1px solid var(--border);
    border-radius: var(--kometio-override-radius, 12px);
    padding: var(--kometio-override-padding-y, 1.5rem)
      var(--kometio-override-padding-x, 1.5rem);
    background: var(--kometio-override-bg, transparent);
    color: var(--kometio-override-text, inherit);
    text-align: center;
  }
  /* No dedicated "accent" token distinct from primary — a highlighted
     plan uses the same "draw attention" role as a primary CTA. */
  .kometio-pricing-plan--highlighted {
    border: 2px solid var(--primary);
  }
  .kometio-pricing-plan__name {
    font-weight: 600;
  }
  .kometio-pricing-plan__price {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 0.5rem;
  }
  .kometio-pricing-plan__period {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--muted-foreground);
  }
  .kometio-pricing-plan__features {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .kometio-pricing-plan__features li {
    padding: 0.375rem 0;
    border-top: 1px solid var(--border);
  }
  .kometio-pricing-plan__button {
    display: inline-block;
    margin-top: 0.5rem;
    padding: var(--button-padding-y, 0.5rem) var(--button-padding-x, 1.25rem);
    border-radius: var(--button-radius, var(--radius));
    background: var(--primary);
    color: var(--primary-foreground);
    text-decoration: none;
  }
</style>
