---
import type { SearchBoxProps } from '@kometio/shared-types';
import { localePath } from '@kometio/theme-runtime';
import type { Translator } from '@kometio/theme-runtime';

interface Props extends SearchBoxProps {
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;

  locale: string;
  i18n: Translator;
}

const { placeholder, visibility, locale, i18n, instanceClass } = Astro.props;
---

<form
  method="get"
  action={localePath(locale, 'search')}
  class:list={[
    'kometio-search-box',
    { 'kometio-visibility-desktop-only': visibility === 'desktop-only' },
    { 'kometio-visibility-mobile-only': visibility === 'mobile-only' },
    instanceClass,
  ]}
  role="search"
>
  <input type="search" name="q" placeholder={placeholder} aria-label={placeholder} />
  <button type="submit">{i18n.t('searchBox.submit')}</button>
</form>

<style>
  /* Fallbacks are what this block already rendered. */
  .kometio-search-box {
    display: flex;
    @kometio-bridge gap background color border-radius padding;
  }
  .kometio-search-box input {
    padding: 0.4rem 0.6rem;
  }
  .kometio-search-box button {
    padding: 0.4rem 0.75rem;
    cursor: pointer;
  }
</style>
