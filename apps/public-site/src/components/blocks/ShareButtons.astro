---
import type { ShareButtonsProps } from '@kometio/shared-types';
import type { PublishedPageTranslation } from '@kometio/api-contracts';
import { localePathFromAncestors, Translator } from '@kometio/theme-runtime';

type Props = ShareButtonsProps & {
  translations: PublishedPageTranslation[];
  pageTitle: string;
  /** The networks' logos, resolved by BlockRenderer from the brand set (ADR-0053). */
  brandIcons?: { whatsapp?: string | null; facebook?: string | null; x?: string | null };
  locale: string;
  instanceClass?: string | null;
};

const {
  label,
  whatsapp,
  facebook,
  linkedin,
  x,
  email,
  copyLink,
  translations,
  pageTitle,
  brandIcons = {},
  locale,
  instanceClass,
} = Astro.props;
const i18n = new Translator(locale);

// The page's own address, built the way PageLayout builds its canonical
// — never `Astro.url`, which carries whatever `?utm_source=` the visitor
// arrived with and would pass it on to everyone they share it with.
const current = translations.find((translation) => translation.locale === locale);
const pageUrl = current
  ? `${Astro.url.origin}${localePathFromAncestors(current.locale, current.ancestorSlugs, current.slug)}`
  : `${Astro.url.origin}${Astro.url.pathname}`;
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(pageTitle);

const lucide = (inner: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
// LinkedIn is absent from the brand set at its owner's request
// (resolve-theme-icons.ts), so it gets the generic share glyph beside its
// name rather than an imitation of its logo.
const SHARE_ICON = lucide('<circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" x2="15.42" y1="13.51" y2="17.49" /><line x1="15.41" x2="8.59" y1="6.51" y2="10.49" />');
const MAIL_ICON = lucide('<path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" /><rect x="2" y="4" width="20" height="16" rx="2" />');
const LINK_ICON = lucide('<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />');
// A brand SVG carries its own <title>; beside a visible name that would be
// read twice, so it is hidden like the others.
const brand = (svg: string | null | undefined) =>
  svg ? svg.replace('<svg', '<svg aria-hidden="true"') : SHARE_ICON;

const links = [
  whatsapp && {
    name: 'WhatsApp',
    href: `https://wa.me/?text=${encodeURIComponent(`${pageTitle} ${pageUrl}`)}`,
    icon: brand(brandIcons.whatsapp),
  },
  facebook && {
    name: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: brand(brandIcons.facebook),
  },
  linkedin && {
    name: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: SHARE_ICON,
  },
  x && {
    name: 'X',
    href: `https://x.com/intent/post?url=${encodedUrl}&text=${encodedTitle}`,
    icon: brand(brandIcons.x),
  },
].flatMap((link) => (link ? [link] : []));
---

{
  (links.length > 0 || email || copyLink) && (
    <div class:list={['kometio-share-buttons', instanceClass]}>
      {label && (
        <p class="kometio-share-buttons__label" data-kometio-field="label">
          {label}
        </p>
      )}
      <ul class="kometio-share-buttons__list">
        {links.map((link) => (
          <li>
            <a
              class="kometio-share-buttons__button"
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={i18n.t('shareButtons.shareOn', { network: link.name })}
            >
              <span class="kometio-share-buttons__icon" set:html={link.icon} />
              <span aria-hidden="true">{link.name}</span>
            </a>
          </li>
        ))}
        {email && (
          <li>
            <a
              class="kometio-share-buttons__button"
              href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`}
              aria-label={i18n.t('shareButtons.shareByEmail')}
            >
              <span class="kometio-share-buttons__icon" set:html={MAIL_ICON} />
              <span aria-hidden="true">{i18n.t('shareButtons.email')}</span>
            </a>
          </li>
        )}
        {copyLink && (
          <li>
            <button
              type="button"
              class="kometio-share-buttons__button"
              data-kometio-copy-text={pageUrl}
              data-kometio-copied-label={i18n.t('copyButton.copied')}
              data-kometio-copy-failed-label={i18n.t('copyButton.failed')}
            >
              <span class="kometio-share-buttons__icon" set:html={LINK_ICON} />
              <span data-kometio-copy-label>{i18n.t('shareButtons.copyLink')}</span>
            </button>
          </li>
        )}
      </ul>
    </div>
  )
}

<script>
  import { copyButtonBehaviors } from '../../lib/block-behaviors/copy-button';
  import { runBlockBehaviors } from '../../lib/block-behaviors/run-block-behaviors';
  runBlockBehaviors(document, copyButtonBehaviors);
</script>

<style>
  .kometio-share-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    background: var(--kometio-override-bg, transparent);
    color: var(--kometio-override-text, inherit);
    border-radius: var(--kometio-override-radius, 0);
    padding: var(--kometio-override-padding-y, 0)
      var(--kometio-override-padding-x, 0);
  }

  .kometio-share-buttons__label {
    margin: 0;
    font-weight: 600;
  }

  .kometio-share-buttons__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--kometio-override-gap, 0.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kometio-share-buttons__button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .kometio-share-buttons__button:hover {
    border-color: currentColor;
  }

  .kometio-share-buttons__button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .kometio-share-buttons__icon {
    display: inline-flex;
  }

  .kometio-share-buttons__icon :global(svg) {
    width: 1rem;
    height: 1rem;
  }
</style>
