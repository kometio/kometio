---
import type { HamburgerMenuProps } from '@kometio/shared-types';
import { Translator } from '@kometio/theme-runtime';

type Props = HamburgerMenuProps & {
  locale: string;
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;
};

const { position, visibility, locale, instanceClass } = Astro.props;
const i18n = new Translator(locale);
const openLabel = i18n.t('hamburgerMenu.open');
const closeLabel = i18n.t('hamburgerMenu.close');
---

<div
  class:list={[
    'kometio-hamburger-menu',
    { 'kometio-hamburger-menu--right': position === 'right' },
    { 'kometio-visibility-desktop-only': visibility === 'desktop-only' },
    { 'kometio-visibility-mobile-only': visibility === 'mobile-only' },
    instanceClass,
  ]}
>
  <button
    type="button"
    class="kometio-hamburger-menu__toggle"
    aria-expanded="false"
    aria-controls="kometio-hamburger-menu__panel"
    aria-label={openLabel}
    data-label-open={openLabel}
    data-label-close={closeLabel}
  >
    <span class="kometio-hamburger-menu__bar"></span>
  </button>
  <div class="kometio-hamburger-menu__panel" id="kometio-hamburger-menu__panel">
    <div class="kometio-hamburger-menu__links">
      <slot />
    </div>
  </div>
</div>

<script>
  // No framework here on purpose (docs/adr/0007: Puck/React stay isolated
  // to apps/editor-app) — a plain click listener toggling one class is
  // all a show/hide dropdown needs. Logic lives in a plain importable
  // module (not inline here) so it can also be re-run after a live canvas
  // insert/patch — see block-behaviors/run-block-behaviors-in-subtree.ts.
  import { hamburgerMenuBehaviors } from '../../lib/block-behaviors/hamburger-menu';
  import { runBlockBehaviors } from '../../lib/block-behaviors/run-block-behaviors';
  runBlockBehaviors(document, hamburgerMenuBehaviors);
</script>

<style>
  /* Visible by default at every width — which breakpoints (if any) hide
     it entirely is the `visibility` prop's job now (the
     kometio-visibility-desktop-only/mobile-only utility classes,
     src/styles/visibility.css), not something hardcoded here. */
  .kometio-hamburger-menu {
    position: relative;
    display: block;
  }
  .kometio-hamburger-menu--right {
    margin-left: auto;
  }

  .kometio-hamburger-menu__toggle {
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  /* Three-bar icon via one middle bar + its ::before/::after — turns
     into an X (rotated bars, middle one hidden) when open. */
  .kometio-hamburger-menu__bar,
  .kometio-hamburger-menu__bar::before,
  .kometio-hamburger-menu__bar::after {
    position: absolute;
    left: 0.375rem;
    right: 0.375rem;
    height: 2px;
    background: currentColor;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .kometio-hamburger-menu__bar {
    top: 50%;
    transform: translateY(-50%);
  }
  .kometio-hamburger-menu__bar::before {
    content: '';
    top: -0.5rem;
  }
  .kometio-hamburger-menu__bar::after {
    content: '';
    top: 0.5rem;
  }
  .kometio-hamburger-menu.kometio-hamburger-menu--open .kometio-hamburger-menu__bar {
    background: transparent;
  }
  .kometio-hamburger-menu.kometio-hamburger-menu--open .kometio-hamburger-menu__bar::before {
    top: 0;
    transform: rotate(45deg);
  }
  .kometio-hamburger-menu.kometio-hamburger-menu--open .kometio-hamburger-menu__bar::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* A full-width panel under the toggle, not a corner-anchored card —
     spans the same width as the header it sits in (left/right: 0 against
     `.kometio-hamburger-menu`'s own full block width), matching a standard
     hamburger dropdown. Overlays whatever is below it (position:
     absolute) instead of pushing page content down. */
  /* On the PANEL, for the same reason as NavDropdown: the wrapper has no
     appearance, so styling it would do nothing visible. Fallbacks are the
     values already in use. */
  .kometio-hamburger-menu__panel {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    z-index: 10;
    padding: var(--kometio-override-padding-y, 1rem)
      var(--kometio-override-padding-x, 1rem);
    background: var(--kometio-override-bg, var(--background));
    color: var(--kometio-override-text, inherit);
    border: var(--kometio-override-border-width, 1px)
      var(--kometio-override-border-style, solid)
      var(--kometio-override-border-color, var(--border));
    border-radius: var(--kometio-override-radius, 8px);
    box-shadow: var(--kometio-override-shadow, 0 8px 24px rgb(0 0 0 / 12%));
  }
  .kometio-hamburger-menu.kometio-hamburger-menu--open .kometio-hamburger-menu__panel {
    display: block;
  }

  .kometio-hamburger-menu__links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  /* NavLink/LanguageSwitcher render their own <a> with no block styling
     of their own (they're also used inline in Nav's horizontal row) —
     :global() reaches into that child markup to give each item a proper
     full-width, tappable row here specifically. */
  .kometio-hamburger-menu__links :global(.kometio-nav-link) {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
  }
  .kometio-hamburger-menu__links :global(.kometio-nav-link:hover) {
    background: var(--muted);
  }
</style>
