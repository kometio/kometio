---
import type { ProductVariantsProps } from '@kometio/shared-types';
import { Translator } from '@kometio/theme-runtime';

type Props = ProductVariantsProps & {
  locale: string;
  editable?: boolean;
  instanceClass?: string | null;
};

const { label, options, locale, editable, instanceClass } = Astro.props;
const i18n = new Translator(locale);
const values = options
  .split('\n')
  .map((option) => option.trim())
  .filter(Boolean);
---

{
  values.length > 0 ? (
    <div class:list={['kometio-product-variants', instanceClass]}>
      {label && <p class="kometio-product-variants__label">{label}</p>}
      {/* A list, not buttons: nothing happens when one is chosen, so
          nothing here offers to be chosen. */}
      <ul class="kometio-product-variants__options" aria-label={label || undefined}>
        {values.map((value) => (
          <li class="kometio-product-variants__option">{value}</li>
        ))}
      </ul>
    </div>
  ) : (
    editable && (
      <p class="kometio-product-variants kometio-product-variants--empty">
        {i18n.t('productVariants.empty')}
      </p>
    )
  )
}

<style>
  .kometio-product-variants {
    display: grid;
    gap: 0.5rem;
    background: var(--kometio-override-bg, transparent);
    color: var(--kometio-override-text, inherit);
    border-radius: var(--kometio-override-radius, 0);
    padding: var(--kometio-override-padding-y, 0)
      var(--kometio-override-padding-x, 0);
  }

  .kometio-product-variants__label {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .kometio-product-variants__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--kometio-override-gap, 0.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kometio-product-variants__option {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.875rem;
  }

  .kometio-product-variants--empty {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
</style>
