---
import type { ArticleNavProps } from '@kometio/shared-types';
import type { Translator } from '@kometio/theme-runtime';
import PrevNextNav from '../PrevNextNav.astro';
import { delegatedRootClass } from '../../lib/delegated-root-class';

type Props = ArticleNavProps & {
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;
  /** The two labels are the block's only words. */
  i18n: Translator;
};

const { previous, next, instanceClass, i18n } = Astro.props;
// Both ends are filled in by the render pass (resolveArticleBlocks): the
// older and newer article in the same collection.
---

<PrevNextNav
  previous={previous}
  next={next}
  label={i18n.t('articleNav.label')}
  previousLabel={i18n.t('articleNav.previous')}
  nextLabel={i18n.t('articleNav.next')}
  instanceClass={delegatedRootClass('kometio-article-nav', instanceClass)}
/>
