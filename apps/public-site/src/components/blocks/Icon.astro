---
import type { IconProps } from '@kometio/shared-types';

type Props = IconProps & {
  /** Resolved by BlockRenderer from the `icon` prop — a block never reaches into the icon registry itself (docs/adr/0023). */
  iconSvg?: string | null;
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;
};

const { size, label, iconSvg, instanceClass } = Astro.props;
// An empty label means decoration: the icon is hidden from assistive
// technology rather than announced as an unnamed graphic. A label makes
// it content, and `role="img"` is what gives that name something to
// attach to.
const decorative = label.trim() === '';
---

{
  iconSvg && (
    <span
      class:list={[`kometio-icon kometio-icon--${size}`, instanceClass]}
      role={decorative ? undefined : 'img'}
      aria-label={decorative ? undefined : label}
      aria-hidden={decorative ? 'true' : undefined}
      set:html={iconSvg}
    />
  )
}

<style>
  .kometio-icon {
    display: inline-flex;
    /* `currentColor` is what makes the colour override work at all: the
       SVG inherits it, so `textColor` paints the icon without this block
       having to rewrite the markup it was given. */
    color: var(--kometio-override-text, currentColor);
  }
  .kometio-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .kometio-icon--sm {
    width: 1rem;
    height: 1rem;
  }
  .kometio-icon--md {
    width: 1.5rem;
    height: 1.5rem;
  }
  .kometio-icon--lg {
    width: 2.5rem;
    height: 2.5rem;
  }
  .kometio-icon--xl {
    width: 4rem;
    height: 4rem;
  }
</style>
