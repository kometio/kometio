---
import type { Block, FaqProps } from '@kometio/shared-types';
import { richTextToPlainText } from '@kometio/shared-types';
import EmptyContainerHint from '../EmptyContainerHint.astro';

type Props = FaqProps & {
  /** The questions, read off the block's own children for the structured data. */
  items?: Block[];
  locale?: string;
  emptyChildLabel?: string | null;
  editable?: boolean;
  hasChildren?: boolean;
  instanceClass?: string | null;
};

const {
  structuredData,
  items = [],
  locale,
  emptyChildLabel,
  editable,
  hasChildren,
  instanceClass,
} = Astro.props;

/*
 * schema.org FAQPage, from the questions actually on the page. Answers as
 * plain text: Google accepts a little HTML there, but what it accepts
 * changes, and plain text is what it never rejects.
 *
 * `<` escaped in the JSON: a question containing "</script>" must not be
 * able to close this tag.
 */
const questions = items
  .filter((item) => item.type === 'AccordionItem')
  .map((item) => ({
    question: String(item.props['question'] ?? '').trim(),
    answer: richTextToPlainText(String(item.props['answer'] ?? '')).trim(),
  }))
  .filter((entry) => entry.question && entry.answer);

const jsonLd =
  structuredData && questions.length > 0
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: questions.map((entry) => ({
          '@type': 'Question',
          name: entry.question,
          acceptedAnswer: { '@type': 'Answer', text: entry.answer },
        })),
      }).replace(/</g, '\\u003c')
    : null;
---

<div
  class:list={['kometio-faq', instanceClass]}
  data-kometio-editable-outline={editable && hasChildren ? '' : undefined}
>
  <slot />
  <EmptyContainerHint
    show={!hasChildren && Boolean(editable)}
    locale={locale}
    childLabel={emptyChildLabel}
  />
  {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
</div>

<style>
  .kometio-faq {
    background: var(--kometio-override-bg, transparent);
    color: var(--kometio-override-text, inherit);
    border-radius: var(--kometio-override-radius, 0);
    padding: var(--kometio-override-padding-y, 0)
      var(--kometio-override-padding-x, 0);
  }
</style>
