---
import type { MapEmbedProps } from '@kometio/shared-types';
import ConsentGatedEmbed from '../ConsentGatedEmbed.astro';
import type { Translator } from '@kometio/theme-runtime';
import { delegatedRootClass } from '../../lib/delegated-root-class';

type Props = MapEmbedProps & {
  i18n: Translator;
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;
};

const { address, i18n, instanceClass } = Astro.props;
const src = address
  ? `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`
  : null;
---

{
  src ? (
    <ConsentGatedEmbed
      instanceClass={delegatedRootClass('kometio-map-embed', instanceClass)}
      src={src}
      title={i18n.t('mapEmbed.title', { address: address ?? '' })}
      buttonLabel={i18n.t('mapEmbed.buttonLabel')}
    />
  ) : (
    <p>{i18n.t('mapEmbed.empty')}</p>
  )
}
