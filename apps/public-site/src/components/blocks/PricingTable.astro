---
import type { PricingTableProps } from '@kometio/shared-types';
import CollectionLayout from '../CollectionLayout.astro';

export type Props = PricingTableProps & {
  editable?: boolean;
  hasChildren?: boolean;
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;
  locale: string;
};

const { display, editable, hasChildren, instanceClass, locale } =
  Astro.props;
---

<CollectionLayout
  blockClass="kometio-pricing-table"
  display={display}
  editable={editable}
  hasChildren={hasChildren}
  instanceClass={instanceClass}
  locale={locale}
>
  <slot />
</CollectionLayout>

<script>
  // Prev/next for the scrolling arrangements — a plain importable module
  // so it can be re-run after a live canvas insert/patch, see
  // block-behaviors/run-block-behaviors-in-subtree.ts.
  import { collectionBehaviors } from '../../lib/block-behaviors/collection';
  import { runBlockBehaviors } from '../../lib/block-behaviors/run-block-behaviors';
  runBlockBehaviors(document, collectionBehaviors);
</script>

<style>
  /*
     `:global()`, and it is not optional: the element these rules target is
     rendered by CollectionLayout.astro, not by this file, so Astro's
     scoped styles never reach it — the block silently lost its grid
     entirely, measured as `display: block` on the built page. Same
     reasoning as Image.astro's `:global(.kometio-image)`, which styles an
     element OptimizedImage renders.
  */
  :global(.kometio-pricing-table) {
    align-items: start;
    background: var(--kometio-override-bg, transparent);
    color: var(--kometio-override-text, inherit);
    border-radius: var(--kometio-override-radius, 0);
    padding: var(--kometio-override-padding-y, 0) var(--kometio-override-padding-x, 0);
  }

  /* Editor only, and only once it has content — when empty it already
     shows its own dashed border through EmptyContainerHint, and a second
     one here would be redundant. Without this, a container holding real
     content loses every visible boundary while you work (user feedback
     from live use, the same reason as Column.astro/Container.astro). */
  :global(.kometio-pricing-table[data-kometio-editable-outline]) {
    outline: 1px dashed var(--border);
    outline-offset: -4px;
    padding: 0.5rem;
  }
</style>
