---
import type { SiteMapProps } from '@kometio/shared-types';
import type { Translator } from '@kometio/theme-runtime';
import SiteMapTree from '../parts/SiteMapTree.astro';

type Props = SiteMapProps & {
  instanceClass?: string | null;
  i18n: Translator;
};

const { tree, instanceClass, i18n } = Astro.props;
// `tree` comes from resolveSiteNavigationBlocks, already cut to the depth
// asked for and without the pages filed in a collection.
---

{
  tree.length > 0 && (
    <nav class:list={['kometio-site-map', instanceClass]} aria-label={i18n.t('siteMap.label')}>
      <SiteMapTree nodes={tree} />
    </nav>
  )
}

<style>
  .kometio-site-map {
    @kometio-bridge background color border-radius padding;
  }
</style>
