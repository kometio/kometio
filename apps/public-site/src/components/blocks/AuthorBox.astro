---
import type { AuthorBoxProps, PickedMedia } from '@kometio/shared-types';
import { Translator } from '@kometio/theme-runtime';
import OptimizedImage from '../OptimizedImage.astro';
import { fixedSizes } from '../../lib/image-sizes';
import { absoluteSchemaUrl } from '../../lib/schema-org';

type Props = AuthorBoxProps & {
  locale: string;
  editable?: boolean;
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;
};

const {
  showBio,
  showArticlesLink,
  author,
  isProfilePage,
  locale,
  editable,
  instanceClass,
} = Astro.props;
const i18n = new Translator(locale);

const name = author?.name.trim() ?? '';
const bio = showBio ? (author?.bio.trim() ?? '') : '';
// Their own page does not link to itself.
const articlesHref =
  showArticlesLink && !isProfilePage ? (author?.path ?? null) : null;
// The first letter as the language writes it — a whole character, never
// half of an accented one or of an emoji.
const initial = Array.from(name)[0]?.toLocaleUpperCase(locale) ?? '';

/**
 * The picture at the size it is drawn, three times over for a sharp
 * screen — not the photo the person uploaded, which can be two thousand
 * pixels across for a circle of sixty-four.
 */
function atSize(media: PickedMedia, pixels: number): PickedMedia {
  if (!media.width || !media.height) return media;
  const scale = Math.min(1, pixels / Math.min(media.width, media.height));
  return {
    ...media,
    width: Math.round(media.width * scale),
    height: Math.round(media.height * scale),
  };
}
const avatar = author?.avatar
  ? atSize(author.avatar, isProfilePage ? 288 : 192)
  : null;

/*
 * On their own page, what the page is about: a ProfilePage whose main
 * entity is the person (what a search engine reads an author page as).
 * The same `@id` as the page's own WebPage node (PageLayout), so the two
 * describe one page rather than two. Only what they chose to publish —
 * `<` escaped for Faq.astro's reason.
 */
const profileUrl = absoluteSchemaUrl(author?.path, Astro.url.origin);
const imageUrl = absoluteSchemaUrl(author?.avatar?.url, Astro.url.origin);
const jsonLd =
  isProfilePage && author && name && profileUrl
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfilePage',
        '@id': `${profileUrl}#webpage`,
        url: profileUrl,
        mainEntity: {
          '@type': 'Person',
          name,
          url: profileUrl,
          ...(author.bio.trim() ? { description: author.bio.trim() } : {}),
          ...(imageUrl ? { image: imageUrl } : {}),
        },
      }).replace(/</g, '\\u003c')
    : null;

// A section of the article, not an `aside` beside it: it sits inside the
// page's `main`, where a complementary landmark does not belong.
const Root = isProfilePage ? 'header' : 'section';
---

{
  !author || !name ? (
    // Nothing on the site: a page whose author has no name has no box.
    // In the canvas, a word on why the block drew nothing.
    editable && (
      <p class:list={['kometio-author-box', 'kometio-author-box--empty', instanceClass]}>
        {i18n.t('authorBox.empty')}
      </p>
    )
  ) : (
    <Root
      class:list={[
        'kometio-author-box',
        { 'kometio-author-box--profile': isProfilePage },
        instanceClass,
      ]}
      aria-label={isProfilePage ? undefined : i18n.t('authorBox.label')}
    >
      {avatar ? (
        <OptimizedImage
          media={avatar}
          alt=""
          class="kometio-author-box__avatar"
          loading={isProfilePage ? 'eager' : 'lazy'}
          sizes={fixedSizes(isProfilePage ? 96 : 64)}
        />
      ) : (
        <span class="kometio-author-box__avatar kometio-author-box__avatar--initial" aria-hidden="true">
          {initial}
        </span>
      )}
      <div class="kometio-author-box__text">
        {isProfilePage ? (
          <h1 class="kometio-author-box__name">{name}</h1>
        ) : (
          <p class="kometio-author-box__name">{name}</p>
        )}
        {bio && <p class="kometio-author-box__bio">{bio}</p>}
        {articlesHref && (
          <a class="kometio-author-box__link" href={articlesHref}>
            {i18n.t('authorBox.allArticles', { name })}
          </a>
        )}
      </div>
      {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    </Root>
  )
}

<style>
  .kometio-author-box {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1rem 1.25rem;
    margin: 0;
    background: var(--kometio-override-bg, transparent);
    color: var(--kometio-override-text, inherit);
    border-radius: var(--kometio-override-radius, var(--radius));
    border-width: var(--kometio-override-border-width, 1px);
    border-style: var(--kometio-override-border-style, solid);
    border-color: var(--kometio-override-border-color, var(--border));
    padding: var(--kometio-override-padding-y, 1.25rem)
      var(--kometio-override-padding-x, 1.25rem);
  }

  /* The top of its own page: nothing above it but the site's header, and
     the page's other blocks only keep space below themselves. */
  .kometio-author-box--profile {
    margin-block-start: 3rem;
  }

  .kometio-author-box--empty {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  /* :global() because OptimizedImage renders the actual <img>. */
  :global(.kometio-author-box__avatar) {
    flex: none;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .kometio-author-box--profile :global(.kometio-author-box__avatar) {
    width: 6rem;
    height: 6rem;
  }

  .kometio-author-box__avatar--initial {
    display: inline-grid;
    place-items: center;
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
  }

  .kometio-author-box--profile .kometio-author-box__avatar--initial {
    font-size: 2.25rem;
  }

  .kometio-author-box__text {
    display: grid;
    gap: 0.375rem;
    /* Beside the picture while there is room, under it when there is not. */
    flex: 1 1 12rem;
    min-width: 0;
  }

  .kometio-author-box__name {
    margin: 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .kometio-author-box__bio {
    margin: 0;
    color: var(--kometio-override-text, var(--muted-foreground));
    /* The line breaks the person typed, and nothing else: it is plain text. */
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .kometio-author-box__link {
    justify-self: start;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--primary);
    /* Underlined: on a theme whose primary colour is nearly the text's own
       (classic), the colour alone would not say it is a link. */
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
</style>
