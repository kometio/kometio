---
/**
 * What a visitor sees on a Kometio that has been deployed but never set up —
 * the window between `docker compose up` and someone completing the
 * first-run wizard.
 *
 * It says what is wrong and what to do, rather than the generic server
 * error this used to be. The audience is realistically the person who just
 * deployed it and typed their own domain into a browser, so the useful
 * thing to show them is where the wizard is.
 *
 * Deliberately self-contained: no site chrome, no theme tokens, no fonts.
 * None of that exists yet — there is no site row to read it from.
 */
interface Props {
  /** The editor's own URL, where the wizard lives. Absent when the deployment never configured one. */
  editorAppUrl: string | null;
}

const { editorAppUrl } = Astro.props;
---

<main class="kometio-not-set-up">
  <h1>Almost there</h1>
  <p>
    Kometio is running, but this installation has not been set up yet. Nothing
    is broken — there is simply no site to show until someone creates the
    first administrator account.
  </p>
  {
    editorAppUrl ? (
      <p>
        <a href={editorAppUrl}>Open the setup wizard</a>
      </p>
    ) : (
      <p>Open the editor to finish setting it up.</p>
    )
  }
  <p class="kometio-not-set-up__aside">
    If you are a visitor rather than this site's owner, please check back
    shortly.
  </p>
</main>

<style>
	.kometio-not-set-up {
		max-width: 34rem;
		margin: 0 auto;
		padding: 4rem 1.5rem;
		font-family: ui-sans-serif, system-ui, sans-serif;
		line-height: 1.6;
		color: #18181b;
	}
	h1 {
		font-size: 1.5rem;
		margin: 0 0 1rem;
	}
	p {
		margin: 0 0 1rem;
	}
	a {
		color: #2563eb;
	}
	.kometio-not-set-up__aside {
		color: #71717a;
		font-size: 0.875rem;
	}
</style>
