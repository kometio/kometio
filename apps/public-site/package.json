{
  "name": "@kometio/public-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node --env-file=../../.env server.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check"
  },
  "nx": {
    "tags": [
      "app"
    ],
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "astro check",
          "cwd": "apps/public-site"
        }
      }
    }
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@kometio/block-registry": "workspace:*",
    "@kometio/block-sdk": "workspace:*",
    "@kometio/env-config": "workspace:*",
    "@kometio/rich-text": "workspace:*",
    "@kometio/rich-text-editor": "workspace:*",
    "@kometio/shared-types": "workspace:*",
    "@kometio/api-contracts": "workspace:*",
    "@kometio/theme-runtime": "workspace:*",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "altcha": "^3.3.0",
    "astro": "^7.3.5",
    "lucide-static": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.34.0",
    "sirv": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
