{
  "name": "@kometio/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node dist/main.js"
  },
  "nx": {
    "tags": [
      "app"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/api/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/api/dist/patches",
          "{workspaceRoot}/apps/api/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ]
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@kometio/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@kometio/api:build:development"
          },
          "production": {
            "buildTarget": "@kometio/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@kometio/aes-secret-cipher": "workspace:*",
    "@kometio/altcha-captcha": "workspace:*",
    "@kometio/anthropic-page-generator": "workspace:*",
    "@kometio/application": "workspace:*",
    "@kometio/block-registry": "workspace:*",
    "@kometio/brevo-newsletter": "workspace:*",
    "@kometio/domain-core": "workspace:*",
    "@kometio/env-config": "workspace:*",
    "@kometio/filesystem-theme-catalog": "workspace:*",
    "@kometio/local-disk-attachment-storage": "workspace:*",
    "@kometio/local-disk-media-storage": "workspace:*",
    "@kometio/mailchimp-newsletter": "workspace:*",
    "@kometio/opaque-token": "workspace:*",
    "@kometio/openai-compatible-page-generator": "workspace:*",
    "@kometio/ports": "workspace:*",
    "@kometio/postgres-dashboard-stats-repository": "workspace:*",
    "@kometio/postgres-db": "workspace:*",
    "@kometio/postgres-form-repository": "workspace:*",
    "@kometio/postgres-import-job-repository": "workspace:*",
    "@kometio/postgres-media-repository": "workspace:*",
    "@kometio/postgres-page-repository": "workspace:*",
    "@kometio/postgres-reusable-section-repository": "workspace:*",
    "@kometio/postgres-search-repository": "workspace:*",
    "@kometio/postgres-site-layout-section-repository": "workspace:*",
    "@kometio/postgres-site-repository": "workspace:*",
    "@kometio/postgres-taxonomy-repository": "workspace:*",
    "@kometio/postgres-user-repository": "workspace:*",
    "@kometio/preview-token-adapter": "workspace:*",
    "@kometio/rich-text": "workspace:*",
    "@kometio/s3-attachment-storage": "workspace:*",
    "@kometio/s3-media-storage": "workspace:*",
    "@kometio/log-email-adapter": "workspace:*",
    "@kometio/session-auth-adapter": "workspace:*",
    "@kometio/sharp-image-optimizer": "workspace:*",
    "@kometio/shared-types": "workspace:*",
    "@kometio/api-contracts": "workspace:*",
    "@kometio/smtp-email-adapter": "workspace:*",
    "@kometio/theme-archive": "workspace:*",
    "@kometio/turnstile-captcha": "workspace:*",
    "@kometio/verification-token-adapter": "workspace:*",
    "@kometio/wordpress-wxr": "workspace:*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@kometio/testing": "workspace:*",
    "@nestjs/testing": "^11.2.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.4",
    "supertest": "^7.3.0"
  }
}
