{
  "name": "@kometio/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "e2e"
    ],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "options": {
          "command": "playwright test",
          "cwd": "apps/e2e"
        }
      },
      "first-run": {
        "executor": "nx:run-commands",
        "options": {
          "command": "playwright test --config=playwright.first-run.config.ts",
          "cwd": "apps/e2e"
        }
      },
      "import": {
        "executor": "nx:run-commands",
        "options": {
          "command": "playwright test --config=playwright.import.config.ts",
          "cwd": "apps/e2e"
        }
      }
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@kometio/env-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "i18next": "^26.4.2",
    "zod": "^4.6.5"
  }
}
