---
import type { ThemeHeaderProps } from '@kometio/theme-runtime';

/**
 * The colour theme's header: a white band under a 3px rule, the name as a
 * yellow plate with a hard shadow, and the menu as square boxes — the entry
 * that is where the reader is, filled mint.
 *
 * The name is the first link of the first `Nav` of the header (a block, not a
 * prop of this region), so it is reached the way a region reaches what core
 * renders: `:global(...)` on that part, with the left-hand side kept scoped so
 * the rule cannot leave this theme. The menu's toggle on a phone is the one
 * core draws (a button with three bars); here it is a mint box with the
 * rule round it, and its panel a white one with the same shadow.
 */
type Props = ThemeHeaderProps;

const { sticky, class: className } = Astro.props;
---

<header
	class:list={[
		'colour-header',
		'kometio-shell-inset',
		className,
		{ 'colour-header--sticky': sticky },
	]}
>
	<slot />
</header>

<style>
	.colour-header {
		/* Above what follows it, always: a page opens with a band that has a
		   layer of its own, and the menu's panel hangs down over it. */
		position: relative;
		z-index: 40;
		border-bottom: var(--colour-rule) solid var(--border);
		background: var(--colour-white);
		/* 12px on a phone, 20px from a 900px window: the design's. */
		padding-block: clamp(0.75rem, 0.3rem + 1.6vw, 1.25rem);
	}

	.colour-header--sticky {
		position: sticky;
		top: 0;
	}

	/* The name: a yellow plate, set in capitals. */
	.colour-header :global(.kometio-nav > .kometio-nav-link:first-child) {
		padding: 0.375rem 0.75rem;
		border: var(--colour-rule) solid var(--border);
		background: var(--colour-yellow);
		box-shadow: 3px 3px 0 var(--border);
		font-family: var(--kometio-heading-font);
		font-size: clamp(1.0625rem, 0.925rem + 0.5618vw, 1.375rem);
		font-weight: 900;
		letter-spacing: -0.01em;
		line-height: normal;
		text-transform: uppercase;
		color: var(--foreground);
		text-decoration: none;
	}

	@media (min-width: 48rem) {
		.colour-header :global(.kometio-nav > .kometio-nav-link:first-child) {
			padding: 0.5rem 1.125rem;
			box-shadow: 4px 4px 0 var(--border);
		}
	}

	.colour-header :global(.kometio-nav) {
		gap: var(--kometio-override-gap, 0.875rem);
		align-items: center;
	}

	/* The menu: square boxes in the same rule. */
	.colour-header :global(.kometio-nav-link:not(:first-child)) {
		padding: 0.5rem 1.125rem;
		border: var(--colour-rule) solid var(--border);
		color: var(--foreground);
		font-size: 1rem;
		font-weight: 700;
		line-height: normal;
		text-decoration: none;
	}

	.colour-header :global(.kometio-nav-link:not(:first-child):hover),
	.colour-header :global(.kometio-nav-link:not(:first-child):focus-visible) {
		background: var(--colour-yellow);
	}

	/* Where the reader is: the entry that is this page, and the one whose
	   section it is in, filled as the design fills its current entry. */
	.colour-header :global(.kometio-nav-link:not(:first-child)[aria-current]) {
		background: var(--colour-mint);
	}

	/* On a phone the menu is the toggle core draws, as a mint box in the rule,
	   and its panel is a white one with the shadow every raised thing here has. */
	.colour-header :global(.kometio-hamburger-menu__toggle) {
		/* A block, so its wrapper is its height and not a line's. */
		display: block;
		width: 3.25rem;
		height: 3.25rem;
		border: var(--colour-rule) solid var(--border);
		border-radius: 0;
		background: var(--colour-mint);
		color: var(--foreground);
	}

	/* The bar is the middle one; the two others are drawn from it (core), so
	   they are given the bar's own width, not the margin the bar has. The box is
	   52px with its rule, as drawn, and its wrapper is as wide as it is. */
	.colour-header :global(.kometio-nav > .kometio-hamburger-menu) {
		width: 3.25rem;
	}

	.colour-header :global(.kometio-hamburger-menu__bar) {
		left: 0.8125rem;
		right: 0.8125rem;
		height: 3px;
	}

	.colour-header :global(.kometio-hamburger-menu__bar::before),
	.colour-header :global(.kometio-hamburger-menu__bar::after) {
		left: 0;
		right: 0;
		height: 3px;
	}

	.colour-header :global(.kometio-hamburger-menu__bar::before) {
		top: -0.4375rem;
	}

	.colour-header :global(.kometio-hamburger-menu__bar::after) {
		top: 0.4375rem;
	}

	.colour-header :global(.kometio-hamburger-menu__panel) {
		border: var(--colour-rule) solid var(--border);
		border-radius: 0;
		background: var(--colour-white);
		box-shadow: 6px 6px 0 var(--border);
		padding: 0.5rem;
	}

	.colour-header :global(.kometio-hamburger-menu__links) {
		gap: 0.5rem;
	}

	.colour-header :global(.kometio-hamburger-menu__links .kometio-nav-link) {
		border: var(--colour-rule) solid var(--border);
		border-radius: 0;
		padding: 0.5rem 0.875rem;
		font-weight: 700;
		color: var(--foreground);
	}

	.colour-header :global(.kometio-hamburger-menu__links .kometio-nav-link:hover),
	.colour-header
		:global(.kometio-hamburger-menu__links .kometio-nav-link:focus-visible) {
		background: var(--colour-yellow);
	}

	.colour-header
		:global(.kometio-hamburger-menu__links .kometio-nav-link[aria-current]) {
		background: var(--colour-mint);
	}
</style>
