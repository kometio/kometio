---
import type { ThemeHeaderProps } from '@kometio/theme-runtime';

/**
 * The night's header: on the ground itself, no rule, the name with the
 * accent's dot in front of it, and the menu as pills — the entry that is
 * where the reader is, lit.
 *
 * The name is the first link of the first `Nav` of the header (a block, not a
 * prop of this region), so it is reached the way a region reaches what core
 * renders: `:global(...)` on that part, with the left-hand side kept scoped
 * so the rule cannot leave this theme. The room for the menu's capsule in the
 * design is not drawn: the entries are the pills, and the pill group's own
 * frame would be a box this region does not own.
 */
type Props = ThemeHeaderProps;

const { sticky, class: className } = Astro.props;
---

<header
	class:list={[
		'night-header',
		'kometio-shell-inset',
		className,
		{ 'night-header--sticky': sticky },
	]}
>
	<slot />
</header>

<style>
	.night-header {
		background: var(--background);
		/* 12px on a phone, 24px from a 900px window: the design's. */
		padding-block: clamp(0.75rem, 0.2rem + 1.9vw, 1.5rem);
	}

	.night-header--sticky {
		position: sticky;
		top: 0;
		z-index: 40;
		background: color-mix(in srgb, var(--background) 82%, transparent);
		backdrop-filter: blur(14px);
	}

	.night-header :global(.kometio-nav > .kometio-nav-link:first-child) {
		gap: 0.75rem;
		font-family: var(--kometio-heading-font);
		font-size: clamp(1.25rem, 1.1rem + 0.4vw, 1.375rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--foreground);
		text-decoration: none;
	}

	/* The accent's dot before the name. */
	.night-header
		:global(.kometio-nav > .kometio-nav-link:first-child)::before {
		content: '';
		flex: none;
		width: 0.875rem;
		height: 0.875rem;
		border-radius: 999px;
		background: var(--primary);
	}

	.night-header :global(.kometio-nav) {
		gap: var(--kometio-override-gap, 0.25rem);
		align-items: center;
	}

	.night-header :global(.kometio-nav-link:not(:first-child)) {
		padding: 0.625rem 1.25rem;
		border-radius: 999px;
		color: var(--muted-foreground);
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
	}

	.night-header :global(.kometio-nav-link:not(:first-child):hover) {
		color: var(--foreground);
		background: var(--night-panel);
	}

	/* Where the reader is: the entry that is this page, and the one whose
	   section it is in, lit as the design lights its current entry. */
	.night-header :global(.kometio-nav-link:not(:first-child)[aria-current]) {
		background: var(--border);
		color: var(--foreground);
	}
</style>
