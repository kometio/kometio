{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../theme-runtime/tsconfig.lib.json"
    },
    {
      "path": "../api-contracts/tsconfig.lib.json"
    },
    {
      "path": "../shared-types/tsconfig.lib.json"
    },
    {
      "path": "../rich-text/tsconfig.lib.json"
    },
    {
      "path": "../ports/tsconfig.lib.json"
    },
    {
      "path": "../domain-core/tsconfig.lib.json"
    },
    {
      "path": "../testing/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ]
}
